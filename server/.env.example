NODE_ENV=development
AUTH_DEBUG=false
UPLOAD_DEBUG=false
MONGODB_URI=mongodb://127.0.0.1:27017/mskprint
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Legacy platform credentials are read only when fallback is explicitly enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Generate one persistent 32-byte key, encoded as 64 hex characters or base64.
# Back it up securely: losing it makes stored shop payment credentials unrecoverable.
SHOP_PAYMENT_ENCRYPTION_KEY=
RAZORPAY_PLATFORM_FALLBACK_ENABLED=false
EMAIL_USER=
EMAIL_PASS=
CLIENT_URL=http://localhost:3000
PORT=5000

# Request security
JSON_BODY_LIMIT=100kb
WEBHOOK_BODY_LIMIT=256kb
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

# Rate limits. Windows are milliseconds and maximums are requests per IP/window.
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=500
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PAYMENT_WINDOW_MS=600000
RATE_LIMIT_PAYMENT_MAX=30
RATE_LIMIT_UPI_WINDOW_MS=600000
RATE_LIMIT_UPI_MAX=15
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=20

# Windows Print Agent
# Agent JWT lifetime (jsonwebtoken duration, for example 8h or 7d).
PRINT_AGENT_TOKEN_TTL=7d
# Maximum time allowed for the backend-to-Cloudinary file stream.
PRINT_AGENT_DOWNLOAD_TIMEOUT_MS=30000
